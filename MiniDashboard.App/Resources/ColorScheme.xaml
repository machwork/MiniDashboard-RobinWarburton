<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Modern Professional Color Scheme -->
    
    <!-- Primary Colors -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/> <!-- Blue 600 -->
    <SolidColorBrush x:Key="PrimaryDarkColor" Color="#1E40AF"/> <!-- Blue 800 -->
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#3B82F6"/> <!-- Blue 500 -->
    <SolidColorBrush x:Key="PrimaryHoverColor" Color="#1D4ED8"/> <!-- Blue 700 -->
    
    <!-- Secondary Colors -->
    <SolidColorBrush x:Key="SecondaryColor" Color="#64748B"/> <!-- Slate 500 -->
    <SolidColorBrush x:Key="SecondaryDarkColor" Color="#475569"/> <!-- Slate 600 -->
    <SolidColorBrush x:Key="SecondaryLightColor" Color="#94A3B8"/> <!-- Slate 400 -->
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFFFFF"/> <!-- White -->
    <SolidColorBrush x:Key="BackgroundSecondaryColor" Color="#F8FAFC"/> <!-- Slate 50 -->
    <SolidColorBrush x:Key="BackgroundTertiaryColor" Color="#F1F5F9"/> <!-- Slate 100 -->
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/> <!-- White -->
    <SolidColorBrush x:Key="SurfaceElevatedColor" Color="#FFFFFF"/> <!-- White -->
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#0F172A"/> <!-- Slate 900 -->
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#475569"/> <!-- Slate 600 -->
    <SolidColorBrush x:Key="TextTertiaryColor" Color="#94A3B8"/> <!-- Slate 400 -->
    <SolidColorBrush x:Key="TextInverseColor" Color="#FFFFFF"/> <!-- White -->
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/> <!-- Slate 200 -->
    <SolidColorBrush x:Key="BorderLightColor" Color="#F1F5F9"/> <!-- Slate 100 -->
    <SolidColorBrush x:Key="BorderDarkColor" Color="#94A3B8"/> <!-- Slate 400 - darker for better visibility -->
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/> <!-- Green 500 -->
    <SolidColorBrush x:Key="SuccessLightColor" Color="#D1FAE5"/> <!-- Green 100 -->
    <SolidColorBrush x:Key="ErrorColor" Color="#EF4444"/> <!-- Red 500 -->
    <SolidColorBrush x:Key="ErrorLightColor" Color="#FEE2E2"/> <!-- Red 100 -->
    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/> <!-- Amber 500 -->
    <SolidColorBrush x:Key="WarningLightColor" Color="#FEF3C7"/> <!-- Amber 100 -->
    <SolidColorBrush x:Key="InfoColor" Color="#3B82F6"/> <!-- Blue 500 -->
    <SolidColorBrush x:Key="InfoLightColor" Color="#DBEAFE"/> <!-- Blue 100 -->
    
    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#F8FAFC"/> <!-- Slate 50 -->
    <SolidColorBrush x:Key="DataGridHeaderForeground" Color="#0F172A"/> <!-- Slate 900 -->
    <SolidColorBrush x:Key="DataGridRowHoverColor" Color="#F1F5F9"/> <!-- Slate 100 -->
    <SolidColorBrush x:Key="DataGridSelectedRowColor" Color="#DBEAFE"/> <!-- Blue 100 -->
    <SolidColorBrush x:Key="DataGridAlternatingRowColor" Color="#FFFFFF"/> <!-- White -->
    
    <!-- Button Styles -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextInverseColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource BackgroundTertiaryColor}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkColor}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BackgroundTertiaryColor}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource BackgroundTertiaryColor}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ErrorColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextInverseColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DC2626"/> <!-- Red 600 -->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource BackgroundTertiaryColor}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- TextBox Style -->
    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BackgroundSecondaryColor}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- ComboBox Style -->
    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BackgroundSecondaryColor}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- DataGrid Style -->
    <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundSecondaryColor}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>
    
    <!-- DataGridRow Style -->
    <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowHoverColor}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridSelectedRowColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- DataGridColumnHeader Style -->
    <Style x:Key="ModernDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DataGridHeaderBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource DataGridHeaderForeground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkColor}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BackgroundTertiaryColor}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- GroupBox Style -->
    <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    
</ResourceDictionary>

