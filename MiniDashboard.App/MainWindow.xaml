<Window x:Class="MiniDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiniDashboard.App.Converters"
        xmlns:behaviors="clr-namespace:MiniDashboard.App.Behaviors"
        mc:Ignorable="d"
        Title="Mini Dashboard" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ColorScheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:EmptyStateVisibilityConverter x:Key="EmptyStateVisibilityConverter"/>
            <converters:PageToBoolConverter x:Key="PageToBoolConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource BackgroundSecondaryColor}"
                Padding="15,12"
                CornerRadius="8"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Mini Dashboard" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryColor}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <Button Grid.Column="1"
                        Command="{Binding OpenMachWorxWebsiteCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <Image Width="90"
                           Stretch="Uniform">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/Images/MachWorxLogo.png"/>
                        </Image.Source>
                    </Image>
                </Button>
            </Grid>
        </Border>

        <!-- Search and Actions -->
        <Border Grid.Row="1" 
                Background="{StaticResource BackgroundSecondaryColor}"
                Padding="10"
                CornerRadius="8"
                Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}"
                             Width="220" 
                             Height="36"
                             Margin="0,0,10,0" 
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button x:Name="SearchButton"
                            Content="Search" 
                            Command="{Binding SearchCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="90" 
                            Margin="0,0,10,0"/>
                    <Button x:Name="RefreshButton"
                            Content="Refresh" 
                            Command="{Binding LoadItemsCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="90" 
                            Margin="0,0,10,0"/>
                    <Button x:Name="AddItemButton"
                            Content="Add New" 
                            Command="{Binding AddItemCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="100"/>
                </StackPanel>
                <!-- Custom Sort - Hidden for now -->
                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Custom Sort:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryColor}"
                               FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding AvailableSortColumns}"
                              SelectedItem="{Binding CustomSortColumn, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Width="120"
                              Height="38"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center"
                              IsEditable="False"/>
                    <TextBox Text="{Binding CustomSortValue, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}"
                             MinWidth="200" 
                             Width="200"
                             Height="38"
                             MinHeight="38"
                             Margin="0,0,10,0" 
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             TextWrapping="NoWrap"
                             AcceptsReturn="False"
                             Padding="8,6"
                             IsEnabled="{Binding IsCustomSortColumnSelected}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyCustomSortCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Apply Sort" 
                            Command="{Binding ApplyCustomSortCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="100" 
                            Margin="0,0,10,0"/>
                    <Button Content="Clear" 
                            Command="{Binding ClearCustomSortCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="70"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Items List -->
        <Border Grid.Row="2" 
                Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderDarkColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                Margin="0,0,0,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Items}" 
                      SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource ModernDataGridStyle}"
                      RowStyle="{StaticResource ModernDataGridRowStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="False"
                      Background="{StaticResource BackgroundColor}"
                      BorderBrush="{StaticResource BorderColor}"
                      behaviors:DataGridColumnHeaderClickBehavior.SortCommand="{Binding SortCommand}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" HeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" HeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" HeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" HeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="100" HeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd}" Width="120" HeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"/>
            </DataGrid.Columns>
            </DataGrid>
            
            <!-- Pagination Controls -->
            <StackPanel Grid.Row="1"
                       Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"
                       Visibility="{Binding TotalPages, Converter={StaticResource CountToVisibilityConverter}}">
                <Button Content="« First" 
                        Command="{Binding FirstPageCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="75" 
                        Height="32"
                        Margin="0,0,5,0"/>
                <Button Content="‹ Prev" 
                        Command="{Binding PreviousPageCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="75" 
                        Height="32"
                        Margin="0,0,5,0"/>
                <TextBlock Text="{Binding PageInfo}" 
                           VerticalAlignment="Center" 
                           Foreground="{StaticResource TextSecondaryColor}"
                           Margin="15,0"
                           FontSize="13"
                           FontWeight="Medium"/>
                <Button Content="Next ›" 
                        Command="{Binding NextPageCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="75" 
                        Height="32"
                        Margin="5,0,5,0"/>
                <Button Content="Last »" 
                        Command="{Binding LastPageCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="75" 
                        Height="32"
                        Margin="5,0,0,0"/>
            </StackPanel>
            
            <StackPanel Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Loading State -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Loading items..." 
                               FontSize="15"
                               Foreground="{StaticResource TextSecondaryColor}"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <ProgressBar Width="240" Height="6" 
                                 IsIndeterminate="True"
                                 HorizontalAlignment="Center">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Background" Value="{StaticResource BackgroundTertiaryColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                
                <!-- Empty State (only when NOT loading) -->
                <TextBlock Text="No items found. Click 'Add New' to create an item." 
                           HorizontalAlignment="Center" 
                           FontSize="15"
                           Foreground="{StaticResource TextSecondaryColor}"
                           FontWeight="Medium">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}">
                            <Binding Path="ItemsCount"/>
                            <Binding Path="IsLoading"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Item Details/Edit Form -->
        <Border Grid.Row="3" 
                Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderDarkColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Item Details" 
                           FontSize="18" 
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryColor}"
                           Margin="0,0,0,15"/>
            <GroupBox BorderThickness="0" Padding="0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Name:" 
                           Foreground="{StaticResource TextPrimaryColor}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" 
                         Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="5,5" 
                         IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Description:" 
                           Foreground="{StaticResource TextPrimaryColor}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" 
                         Text="{Binding SelectedItem.Description, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="5,5" 
                         IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Category:" 
                           Foreground="{StaticResource TextPrimaryColor}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" 
                         Text="{Binding SelectedItem.Category, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="5,5" 
                         IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Price:" 
                           Foreground="{StaticResource TextPrimaryColor}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" 
                         Text="{Binding SelectedItem.Price, UpdateSourceTrigger=LostFocus}" 
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="5,5" 
                         IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"/>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="5,15,0,0">
                    <Button Content="Save" 
                            Command="{Binding SaveItemCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="90" 
                            Height="36"
                            Margin="0,0,10,0"/>
                    <Button Content="Cancel" 
                            Command="{Binding CancelEditCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="90" 
                            Height="36"
                            Margin="0,0,10,0"/>
                    <Button Content="Delete" 
                            Command="{Binding DeleteItemCommand}" 
                            Style="{StaticResource DangerButtonStyle}"
                            Width="90" 
                            Height="36"/>
                </StackPanel>
            </Grid>
            </GroupBox>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource ErrorLightColor}" 
                        BorderBrush="{StaticResource ErrorColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="{StaticResource ErrorColor}" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium"
                                   Margin="0,0,10,0"/>
                        <Button Content="✕" 
                                Command="{Binding ClearErrorCommand}"
                                Width="22" Height="22" 
                                Padding="0"
                                FontSize="11"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource ErrorColor}"
                                Cursor="Hand"
                                ToolTip="Clear error message">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" 
                                                        CornerRadius="3"
                                                        Padding="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Copyright Footer -->
        <Border Grid.Row="5"
                Margin="0,15,0,0"
                Padding="10,8"
                HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink Command="{Binding OpenMachWorxWebsiteCommand}"
                           Foreground="{StaticResource TextSecondaryColor}"
                           TextDecorations="Underline"
                           Cursor="Hand">
                    © Copyright 2026 MachWorx Software Solutions. All Rights Reserved
                </Hyperlink>
            </TextBlock>
        </Border>
    </Grid>
</Window>
